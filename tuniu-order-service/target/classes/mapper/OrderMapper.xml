<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tuniu.order.dao.OrderMapper">

    <resultMap id="OrderResult" type="com.tuniu.common.domain.Orders">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="status" column="status"/>
        <result property="totalPrice" column="total_price"/>
        <result property="time" column="time"/>
    </resultMap>

    <insert id="insert" parameterType="com.tuniu.common.domain.Orders" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (user_id, status, total_price, time)
        VALUES (#{userId}, #{status}, #{totalPrice}, #{time})
    </insert>

    <update id="updateStatusById">
        UPDATE orders SET status = #{status} WHERE id = #{id}
    </update>

    <select id="list" resultMap="OrderResult">
        SELECT id, user_id, status, total_price, time
        FROM orders
        <where>
            <if test="userId != null">
                user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY time DESC
    </select>

    <select id="findById" resultMap="OrderResult">
        SELECT id, user_id, status, total_price, time
        FROM orders
        WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM orders WHERE id = #{id}
    </delete>
</mapper>
